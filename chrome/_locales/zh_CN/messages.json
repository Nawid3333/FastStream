    "welcome_page_usage_content0": {
        "message": "使用 FastStream 的四种方式"
    },
    "welcome_page_usage_content1": {
        "message": "前往有视频流的网站，点击图标开启 FastStream。播放流媒体时客户端会自动被 FastStream 替换。"
    },
    "welcome_page_usage_content2": {
        "message": "在新标签页中点击扩展图标即可打开播放器。"
    },
    "welcome_page_usage_content3": {
        "message": "如果已启用此选项，访问 mp4/mpd/m3u8 链接即可由播放器播放。"
    },
    "welcome_page_usage_content4": {
        "message": "在新标签页中保持播放器打开，它会在你浏览其他页面时收集视频源。"
    },
    "welcome_page_usage_end": {
        "message": "感谢安装 FastStream！如有问题或建议，请告知我们。"
    },
