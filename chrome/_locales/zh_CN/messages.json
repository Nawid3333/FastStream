    "perms_page_title": {
        "message": "FastStream 权限"
    },
    "perms_page_about_header": {
        "message": "关于 FastStream 所需的权限"
    },
    "perms_page_about_content0": {
        "message": "为了使扩展正常运行，需要某些权限。这些权限仅用于基本功能。"
    },
    "perms_page_about_content1": {
        "message": "FastStream 不会收集你的任何数据，也不会追踪你。它没有自己的服务器，只会连接到你所播放视频的网站、你搜索字幕时的 OpenSubtitles，以及用于检查更新的 GitHub。"
    },
    "perms_page_about_content2": {
        "message": "不信？FastStream 的源码公开托管于"
    },
    "perms_page_about_content3": {
        "message": "你可以查看代码，或按说明手动安装自定义构建。"
    },
    "perms_page_breakdown_header": {
        "message": "权限说明"
    },
    "perms_page_breakdown_content0": {
        "message": "下面是 FastStream 所需权限以及原因说明。"
    },
    "perms_page_breakdown_content1": {
        "message": "注意：链接示例可能指向旧版代码，但大意应相同。该列表并非详尽无遗，项按重要性排序。"
    },
    "perms_page_breakdown_perm1h": {
        "message": "访问并修改所有网站"
    },
    "perms_page_breakdown_perm1d": {
        "message": "FastStream 需要访问所有网站，以便将播放器直接注入到网站中。它会向你访问的网站注入内容脚本以便："
    },
    "perms_page_breakdown_perm1r1": {
        "message": "识别可见的最大视频元素并替换为播放器。"
    },
    "perms_page_breakdown_perm1r2": {
        "message": "当播放器注入到框架内时启用全屏权限。"
    },
    "perms_page_breakdown_perm1r3": {
        "message": "从页面抓取字幕 <track> 元素。"
    },
    "perms_page_breakdown_perm2h": {
        "message": "访问 webRequest API"
    },
    "perms_page_breakdown_perm2d": {
        "message": "FastStream 需要拦截指向视频源的 HTTP 请求以便："
    },
    "perms_page_breakdown_perm2r1": {
        "message": "识别视频源"
    },
    "perms_page_breakdown_perm3h": {
        "message": "访问 declarativeNetRequest API"
    },
    "perms_page_breakdown_perm3d": {
        "message": "FastStream 需要修改部分请求的 HTTP 头以便："
    },
    "perms_page_breakdown_perm3r1": {
        "message": "覆盖视频源的请求头。"
    },
    "perms_page_breakdown_perm4h": {
        "message": "在浏览器中存储数据"
    },
    "perms_page_breakdown_perm4d": {
        "message": "FastStream 需要在浏览器中存储数据以记住你的设置。"
    },
    "perms_page_breakdown_perm4r1": {
        "message": "常规扩展选项。"
    },
    "perms_page_breakdown_perm5h": {
        "message": "访问 tabs API"
    },
    "perms_page_breakdown_perm5d": {
        "message": "FastStream 需要在每个标签页的播放器与内容脚本之间发送消息。"
    },
    "perms_page_breakdown_perm5r1": {
        "message": "从后台脚本向播放器发送视频源。"
    },
    "perms_page_breakdown_perm6h": {
        "message": "与 Firefox 之外的其他程序交换消息"
    },
    "perms_page_breakdown_perm6d": {
        "message": "仅用于 mpv：把视频交给 mpv 时，FastStream 会将它传给你电脑上的 FastStream mpv 主机，由主机在 mpv 中打开。没有该主机时，此权限从不使用。"
    },
    "perms_page_breakdown_perm7h": {
        "message": "下载文件"
    },
    "perms_page_breakdown_perm7d": {
        "message": "FastStream 会在你要求时把文件保存到下载文件夹：视频、截图、字幕文件或你导出的设置。"
    },
    "perms_page_breakdown_perm8h": {
        "message": "访问 cookies API"
    },
    "perms_page_breakdown_perm8d": {
        "message": "仅用于查看标签页所在的 Firefox 容器，以便在容器标签页中开始的下载在同一容器中进行。FastStream 从不读取、修改或发送你的 Cookie。"
    },
