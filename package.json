{
  "name": "faststream",
  "version": "1.3.77",
  "description": "Stream videos without buffering. Fix bad video players on the internet.",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node localescript.mjs && node build.mjs",
    "build:keep": "node localescript.mjs && node build.mjs --keep",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "lint:amo": "web-ext lint --source-dir=build_firefox_libre",
    "lint:amo:dist": "web-ext lint --source-dir=build_firefox_dist",
    "profile:setup": "node tools/setup-dev-profile.mjs",
    "start:ff": "web-ext run --source-dir=build_firefox_libre --target=firefox-desktop --firefox-profile=.dev-profile --profile-create-if-missing --keep-profile-changes",
    "start:ff:clean": "web-ext run --source-dir=build_firefox_libre --target=firefox-desktop",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen-locale": "node generate-locales.mjs",
    "combine-locales": "node localescript.mjs --combine",
    "split-locales": "node localescript.mjs --split"
  },
  "repository": {
    "type": "git",
    "url": "git+https://andrews54757@github.com/Andrews54757/FastStream.git"
  },
  "author": "Andrews54757",
  "bugs": {
    "url": "https://github.com/Andrews54757/FastStream/issues"
  },
  "homepage": "https://github.com/Andrews54757/FastStream#readme",
  "devDependencies": {
    "@types/chrome": "^0.2.7",
    "eslint": "^8.49.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-n": "^16.0.2",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-promise": "^6.1.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "web-ext": "^10.6.0"
  }
}
