{
  "name": "faststream",
  "version": "1.3.77",
  "description": "Stream videos without buffering. Fix bad video players on the internet.",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "vendor:sync": "node tools/sync-vendor.mjs",
    "build": "node tools/sync-vendor.mjs && node localescript.mjs && node build.mjs",
    "build:keep": "node tools/sync-vendor.mjs && node localescript.mjs && node build.mjs --keep",
    "lint": "eslint . --ext .js,.mjs",
    "typecheck": "tsc --noEmit",
    "lint:github": "web-ext lint --source-dir=build_firefox_github",
    "lint:amo": "web-ext lint --source-dir=build_firefox_amo",
    "profile:setup": "node tools/setup-dev-profile.mjs",
    "start:ff": "node tools/launch-ff.mjs",
    "start:ff:fresh": "node tools/launch-ff-fresh.mjs",
    "start:ff:clean": "web-ext run --source-dir=build_firefox_github --target=firefox-desktop",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen-locale": "node generate-locales.mjs",
    "combine-locales": "node localescript.mjs --combine",
    "split-locales": "node localescript.mjs --split",
    "start:ff:amo": "node tools/launch-ff.mjs amo",
    "start:ff:fresh:amo": "node tools/launch-ff-fresh.mjs amo",
    "test:e2e": "wdio run tests/e2e/wdio.conf.mjs",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm test && pnpm run build:keep && pnpm run lint:github && pnpm run lint:amo && pnpm run test:e2e",
    "verify:vtt": "node tools/verify-vtt.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://andrews54757@github.com/Andrews54757/FastStream.git"
  },
  "author": "Andrews54757",
  "bugs": {
    "url": "https://github.com/Andrews54757/FastStream/issues"
  },
  "homepage": "https://github.com/Andrews54757/FastStream#readme",
  "devDependencies": {
    "@types/chrome": "^0.2.7",
    "@wdio/cli": "^9.31.5",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.31.5",
    "@wdio/mocha-framework": "^9.31.5",
    "@wdio/spec-reporter": "^9.31.2",
    "Coloris": "github:mdbassit/Coloris#v0.21.1",
    "acorn": "8.18.0",
    "dashjs": "5.1.0",
    "eslint": "^8.49.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-n": "^16.0.2",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-promise": "^6.1.1",
    "fuse.js": "7.1.0",
    "geckodriver": "^6.1.1",
    "gif.js": "0.2.0",
    "hls.js": "^1.6.9",
    "jswebm": "0.1.2",
    "mp4-muxer": "4.3.3",
    "onnxruntime-web": "1.20.0",
    "pako": "2.1.0",
    "sortablejs": "1.15.2",
    "sweetalert2": "11.12.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "web-ext": "^10.6.0"
  }
}
