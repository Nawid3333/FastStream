{
  "name": "faststream",
  "version": "1.3.82.4",
  "description": "Stream videos without buffering. Fix bad video players on the internet.",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "vendor:sync": "node tools/sync-vendor.mjs",
    "build": "node tools/sync-vendor.mjs && node localescript.mjs && node build.mjs",
    "build:keep": "node tools/sync-vendor.mjs && node localescript.mjs && node build.mjs --keep",
    "lint": "eslint . --ext .js,.mjs",
    "typecheck": "tsc --noEmit",
    "lint:github": "web-ext lint --source-dir=build_firefox_github",
    "lint:amo": "web-ext lint --source-dir=build_firefox_amo --self-hosted",
    "profile:setup": "node tools/setup-dev-profile.mjs",
    "start:ff": "node tools/launch-ff.mjs",
    "start:ff:fresh": "node tools/launch-ff-fresh.mjs",
    "start:ff:clean": "web-ext run --source-dir=build_firefox_github --target=firefox-desktop",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "gen-locale": "node generate-locales.mjs",
    "combine-locales": "node localescript.mjs --combine",
    "split-locales": "node localescript.mjs --split",
    "start:ff:amo": "node tools/launch-ff.mjs amo",
    "start:ff:fresh:amo": "node tools/launch-ff-fresh.mjs amo",
    "test:e2e": "wdio run tests/e2e/wdio.conf.mjs",
    "test:e2e:chromium": "wdio run tests/e2e/wdio.chromium.conf.mjs",
    "test:e2e:all": "wdio run tests/e2e/wdio.conf.mjs && wdio run tests/e2e/wdio.chromium.conf.mjs",
    "test:ext": "wdio run tests/e2e/wdio.extension.conf.mjs",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm test && pnpm run build:keep && pnpm run lint:github && pnpm run lint:amo && pnpm run test:e2e && pnpm run test:e2e:chromium && pnpm run test:ext && pnpm run verify:ort",
    "verify:vtt": "node tools/verify-vtt.mjs",
    "verify:vad": "node tools/verify-vad.mjs",
    "verify:ort": "node tools/verify-ort.mjs",
    "verify:knob": "node tools/verify-knob.mjs",
    "sign:amo": "node tools/sign-amo.mjs",
    "sign:amo:listed": "node tools/sign-amo.mjs --listed",
    "release": "node tools/cut-release.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nawid3333/FastStream.git"
  },
  "author": "Nawid3333",
  "bugs": {
    "url": "https://github.com/Nawid3333/FastStream/issues"
  },
  "homepage": "https://github.com/Nawid3333/FastStream#readme",
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/chrome": "^0.2.9",
    "@vitest/coverage-v8": "^5.0.0",
    "@wdio/cli": "^9.31.7",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.31.7",
    "@wdio/mocha-framework": "^9.31.7",
    "@wdio/spec-reporter": "^9.31.2",
    "Coloris": "github:mdbassit/Coloris#v0.25.0",
    "acorn": "8.18.0",
    "chromedriver": "^152.0.3",
    "dashjs": "5.1.0",
    "edgedriver": "^6.3.0",
    "eslint": "^10.10.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-promise": "^7.3.0",
    "fuse.js": "7.5.0",
    "geckodriver": "^6.1.1",
    "gif.js": "0.2.0",
    "globals": "^16.5.0",
    "hls.js": "^1.7.3",
    "jswebm": "0.1.2",
    "mp4-muxer": "4.3.3",
    "mp4box": "0.5.3",
    "onnxruntime-web": "1.20.0",
    "pako": "3.0.1",
    "sortablejs": "1.15.7",
    "sweetalert2": "11.26.25",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0",
    "web-ext": "^10.6.0"
  }
}
