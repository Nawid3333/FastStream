{
  "name": "faststream",
  "version": "1.3.82.135",
  "description": "Stream videos without buffering. Fix bad video players on the internet.",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "vendor:sync": "node tools/sync-vendor.mjs",
    "build": "node tools/sync-vendor.mjs && node localescript.mjs && node build.mjs",
    "build:keep": "node tools/sync-vendor.mjs && node localescript.mjs && node build.mjs --keep",
    "lint": "eslint . --ext .js,.mjs && eslint -c eslint.modules.config.js chrome/player/modules",
    "typecheck": "tsc --noEmit",
    "typecheck:strict": "node tools/check-implicit-any.mjs",
    "lint:github": "web-ext lint --source-dir=build_firefox_github",
    "lint:amo": "web-ext lint --source-dir=build_firefox_amo --self-hosted",
    "profile:setup": "node tools/setup-dev-profile.mjs",
    "start:ff": "node tools/launch-ff.mjs",
    "start:ff:fresh": "node tools/launch-ff-fresh.mjs",
    "start:ff:clean": "web-ext run --source-dir=build_firefox_github --target=firefox-desktop",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:workflows": "bash tests/workflows/run.sh",
    "gen-locale": "node generate-locales.mjs",
    "combine-locales": "node localescript.mjs --combine",
    "split-locales": "node localescript.mjs --split",
    "start:ff:amo": "node tools/launch-ff.mjs amo",
    "start:ff:fresh:amo": "node tools/launch-ff-fresh.mjs amo",
    "test:e2e": "wdio run tests/e2e/wdio.conf.mjs",
    "test:ext": "wdio run tests/e2e/wdio.extension.conf.mjs && wdio run tests/e2e/wdio.classic.conf.mjs",
    "test:ext:github": "node tools/test-ext-github.mjs",
    "test:pbm": "wdio run tests/e2e/wdio.pbm.conf.mjs",
    "test:live": "wdio run tests/e2e/wdio.live.conf.mjs",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm test && pnpm run build:keep && pnpm run lint:github && pnpm run lint:amo && pnpm run test:e2e && pnpm run test:ext && pnpm run test:ext:github && pnpm run test:pbm && pnpm run verify:vtt && pnpm run verify:fsaunpack",
    "verify:linux": "node tools/verify-linux.mjs",
    "verify:vtt": "node tools/verify-vtt.mjs",
    "verify:fsaunpack": "node tools/verify-fsaunpack.mjs",
    "sign:amo": "node tools/sign-amo.mjs",
    "sign:amo:listed": "node tools/sign-amo.mjs --listed",
    "release": "node tools/cut-release.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nawid3333/FastStream.git"
  },
  "author": "Nawid3333",
  "bugs": {
    "url": "https://github.com/Nawid3333/FastStream/issues"
  },
  "homepage": "https://github.com/Nawid3333/FastStream#readme",
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "@wdio/cli": "^10.1.0",
    "@wdio/globals": "^10.1.0",
    "@wdio/local-runner": "^10.1.0",
    "@wdio/mocha-framework": "^10.1.0",
    "@wdio/spec-reporter": "^10.1.0",
    "Coloris": "github:mdbassit/Coloris#v0.25.0",
    "acorn": "8.19.0",
    "dashjs": "5.2.1",
    "eslint": "^10.13.0",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-promise": "^7.3.0",
    "fast-check": "^4.10.2",
    "fuse.js": "7.5.0",
    "geckodriver": "^8.0.0",
    "gif.js": "0.2.0",
    "globals": "^17.13.0",
    "hls.js": "1.7.3",
    "js-yaml": "^5.5.0",
    "mediabunny": "1.61.6",
    "mp4box": "2.4.1",
    "sortablejs": "1.15.7",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "web-ext": "^10.8.0",
    "webdriverio": "^10.1.0"
  }
}
