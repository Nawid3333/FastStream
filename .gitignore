# WebdriverIO driver logs and failure screenshots from the e2e suite.
logs/
# Firefox's network log of a failed e2e attempt (tests/e2e/mozLog.mjs).
logs-moz/

# Real downloads the e2e suite triggers through the browser - wiped before
# and after every run by the wdio configs, but never meant to be committed.
.e2e-downloads/

# AMO signing credentials. Never commit these.
.amo-credentials.json

# addons-linter JSON dumps.
lint-amo.json
lint-*.json

# vitest --coverage output.
coverage/

# The helper's launch lock (faststream-mpv-host.mjs launchLockFile), next to it while mpv starts.
native-host/faststream-mpv-launch-*.lock
