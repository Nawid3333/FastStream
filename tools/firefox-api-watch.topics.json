  "bugzilla": {
    "_comment": "WebExtensions bugs are all read (a handful a release) and matched by the namespaces the code uses; Core media bugs only with a documentation/compatibility keyword or a summary naming a high-priority media term, and never the Android-only ones.",
    "coreComponents": [
      "Audio/Video",
      "Audio/Video: Playback",
      "Audio/Video: Web Codecs",
      "DOM: Networking",
      "DOM: Service Workers",
      "Networking: Cookies",
      "Storage: IndexedDB",
      "Storage: Quota Manager"
    ],
    "coreKeywords": [
      "dev-doc-needed",
      "dev-doc-complete",
      "site-compat",
      "addon-compat"
    ],
    "coreSummary": "\\b(MediaSource|SourceBuffer|MSE|fMP4|HLS|DASH|seek(ing)?|WMF|Media Foundation|hardware[- ]decod\\w*|VideoDecoder|AudioDecoder|WebCodecs|MediaCapabilities|decodingInfo|HEVC|AV1|OPFS|SyncAccessHandle|createWritable|Range requests?|partial content)\\b",
